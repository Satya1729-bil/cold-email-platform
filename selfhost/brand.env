# ------------------------------------------------------------------
# Your brand and domain. Edit these values, save, then commit to git.
# No secrets here. Secrets are made on the server and never go to git.
# Do not leave a value empty: delete the line instead.
# ------------------------------------------------------------------

# The domain the app will live on (used only on the AWS server).
# The server will use app., admin., api., ws., track., forms. and portal. under it.
DOMAIN=yourbrand.com

# Name shown on the login page and in system emails (login codes, invites, alerts)
EMAIL_BRAND_NAME=YourBrand
EMAIL_BRAND_LEGAL_ENTITY=YourBrand Pvt Ltd
EMAIL_BRAND_ADDRESS=Your office address, City, India
EMAIL_BRAND_WEBSITE_URL=https://yourbrand.com
EMAIL_BRAND_SUPPORT_EMAIL=support@yourbrand.com

# Sender name and address for system emails
EMAIL_NAME=YourBrand
EMAIL_ADDRESS=noreply@yourbrand.com
